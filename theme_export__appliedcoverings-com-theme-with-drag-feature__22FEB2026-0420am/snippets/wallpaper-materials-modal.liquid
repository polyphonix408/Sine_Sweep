{% comment %}
  Material Comparison Modal
  Usage: {% render 'wallpaper-materials-modal', product: product %}
  
  Accesses material data from product.metafields.custom.material (metaobject reference list)
  Matches materials to variants by name for pricing
{% endcomment %}

<!-- Modal HTML -->
<div id="materials-modal" class="materials-modal" style="display: none;">
  <div class="materials-modal-overlay"></div>
  <div class="materials-modal-content">
    <div class="materials-modal-header">
      <h2>Material Comparison</h2>
      <button type="button" class="materials-modal-close" aria-label="Close">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <div class="materials-modal-body">
      <div class="materials-comparison-table">
        <table>
          <thead>
            <tr>
              <th class="feature-column"></th>
              {% assign materials = product.metafields.custom.material.value %}
              {% for material in materials %}
                <th class="material-column">
                  <div class="material-name">{{ material.name.value }}</div>
                </th>
              {% endfor %}
            </tr>
          </thead>
          <tbody>
            <!-- Description Row -->
            <tr class="description-row">
              <td class="feature-label">Description</td>
              {% for material in materials %}
                <td class="material-description">
                  {{ material.description.value }}
                </td>
              {% endfor %}
            </tr>
            
            <!-- Price Row -->
            <tr class="price-row">
              <td class="feature-label">Price</td>
              {% for material in materials %}
                {% comment %} Find matching variant by comparing material name to variant title {% endcomment %}
                {% assign material_name = material.name.value %}
                {% assign matching_variant = null %}
                {% for variant in product.variants %}
                  {% if variant.title == material_name %}
                    {% assign matching_variant = variant %}
                    {% break %}
                  {% endif %}
                {% endfor %}
                <td class="material-price">
                  {% if matching_variant %}
                    <span class="price-amount">${{ matching_variant.price | money_without_currency }}</span>
                  {% else %}
                    <span class="price-amount">-</span>
                  {% endif %}
                  <span class="price-unit">/ sq ft</span>
                </td>
              {% endfor %}
            </tr>
            
            <!-- Application Row -->
            <tr class="application-row">
              <td class="feature-label">Application</td>
              {% for material in materials %}
                <td class="material-application">
                  {{ material.application.value }}
                </td>
              {% endfor %}
            </tr>
            
            <!-- Installation Rating Row -->
            <tr class="rating-row">
              <td class="feature-label">Installation</td>
              {% for material in materials %}
                <td class="material-rating">
                  {% assign rating = material.installation_rating.value.rating | default: material.installation_rating.value | default: 3 | plus: 0 %}
                  <div class="rating-dots">
                    {% for i in (1..5) %}
                      <span class="rating-dot {% if i <= rating %}filled{% endif %}"></span>
                    {% endfor %}
                  </div>
                </td>
              {% endfor %}
            </tr>
            
            <!-- Durability Rating Row -->
            <tr class="rating-row">
              <td class="feature-label">Durability</td>
              {% for material in materials %}
                <td class="material-rating">
                  {% assign rating = material.durability_rating.value.rating | default: material.durability_rating.value | default: 3 | plus: 0 %}
                  <div class="rating-dots">
                    {% for i in (1..5) %}
                      <span class="rating-dot {% if i <= rating %}filled{% endif %}"></span>
                    {% endfor %}
                  </div>
                </td>
              {% endfor %}
            </tr>
            
            <!-- Removability Rating Row -->
            <tr class="rating-row">
              <td class="feature-label">Removability</td>
              {% for material in materials %}
                <td class="material-rating">
                  {% assign rating = material.removability_rating.value.rating | default: material.removability_rating.value | default: 3 | plus: 0 %}
                  <div class="rating-dots">
                    {% for i in (1..5) %}
                      <span class="rating-dot {% if i <= rating %}filled{% endif %}"></span>
                    {% endfor %}
                  </div>
                </td>
              {% endfor %}
            </tr>
            
            <!-- Best For Row -->
            <tr class="best-for-row">
              <td class="feature-label">Best for</td>
              {% for material in materials %}
                <td class="material-best-for">
                  {{ material.best_for.value }}
                </td>
              {% endfor %}
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<style>
/* Materials Modal Styles */
.materials-modal {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
}

.materials-modal-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.5);
  cursor: pointer;
}

.materials-modal-content {
  position: relative;
  background: white;
  border-radius: 8px;
  box-shadow: 0 10px 40px rgba(0, 0, 0, 0.2);
  max-width: 1400px;
  width: 95%;
  max-height: 90vh;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.materials-modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16px;
  border-bottom: 1px solid #e5e5e5;
}

.materials-modal-header h2 {
  margin: 0;
  font-size: 18px;
  font-weight: 600;
  color: #333;
}

.materials-modal-close {
  background: none;
  border: none;
  cursor: pointer;
  padding: 8px;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #666;
  transition: color 0.2s;
}

.materials-modal-close:hover {
  color: #333;
}

.materials-modal-body {
  flex: 1;
  overflow-y: auto;
  padding: 0px;
}

/* Comparison Table Styles */
.materials-comparison-table {
  width: 100%;
  overflow-x: auto;
}

.materials-comparison-table table {
  width: 100%;
  border-collapse: separate;
  border-spacing: 0;
}

.materials-comparison-table th,
.materials-comparison-table td {
  padding: 8px 8px;
  border-right: 1px solid #e5e5e5;
  text-align: center;
}

.materials-comparison-table th:last-child,
.materials-comparison-table td:last-child {
  border-right: none;
}

/* Header Row */
.materials-comparison-table thead tr {
  background: #f8f9fa;
}

.materials-comparison-table th {
  font-weight: 600;
  color: #333;
  vertical-align: top;
  position: sticky;
  top: 0;
  background: #f8f9fa;
  z-index: 1;
}

.material-name {
  font-size: 14px;
  font-weight: 600;
  color: #1897aa;
  line-height: 1.4;
  text-transform: capitalize;
}

/* Feature Column */
.feature-column {
  width: 110px;
  min-width: 110px;
}

.material-column {
  width: auto;
  min-width: 180px;
  text-align: center;
}

.feature-label {
  font-weight: 600;
  color: #333;
  background: #f8f9fa;
  position: sticky;
  left: 0;
  z-index: 1;
  text-align: left;
  text-transform: uppercase;
  font-size: 10px;
  letter-spacing: 0.5px;
}

/* Content Rows */
.materials-comparison-table tbody tr {
  border-bottom: 1px solid #e5e5e5;
}

.materials-comparison-table tbody tr:last-child {
  border-bottom: none;
}

/* Description Row */
.description-row {
  background: #fbfbfb;
}

.material-description {
  font-size: 10px;
  line-height: 1.4;
  color: #666;
  vertical-align: top;
  text-align: left !important;
}

/* Price Row */
.price-row {
  background: #f0f9fb;
}

.material-price {
  font-weight: 600;
  color: #1897aa;
}

.price-amount {
  font-size: 16px;
  font-weight: 700;
  color: #1897aa;
}

.price-unit {
  font-size: 10px;
  color: #666;
  font-weight: normal;
}

/* Application Row */
.material-application {
  font-size: 10px;
  color: #666;
}

/* Rating Rows */
.rating-row {
  background: #fbfbfb;
}

.rating-dots {
  display: flex;
  gap: 4px;
  justify-content: center;
}

.rating-dot {
  width: 16px;
  height: 16px;
  border-radius: 50%;
  background: #e5e5e5;
  display: inline-block;
}

.rating-dot.filled {
  background: #1897aa;
}

/* Best For Row */
.best-for-row {
  background: #f8f9fa;
}

.material-best-for {
  font-size: 10px;
  color: #666;
  font-style: italic;
}

/* Responsive */
@media (max-width: 768px) {
  .materials-modal-content {
    width: 95%;
    max-height: 95vh;
  }
  
  .materials-modal-body {
    padding: 16px;
  }
  
  .materials-comparison-table {
    font-size: 14px;
  }
  
  .material-name {
    font-size: 14px;
  }
  
  .price-amount {
    font-size: 16px;
  }
  
  .rating-dot {
    width: 16px;
    height: 16px;
  }
}

/* Animation */
@keyframes modalFadeIn {
  from {
    opacity: 0;
    transform: scale(0.95);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}

.materials-modal.active {
  display: flex;
}

.materials-modal.active .materials-modal-content {
  animation: modalFadeIn 0.3s ease;
}
</style>

<script>
// Materials Modal JavaScript
(function() {
  // Initialize modal functionality
  function initMaterialsModal() {
    const modal = document.getElementById('materials-modal');
    const openBtn = document.getElementById('compare-materials-btn');
    const closeBtn = modal?.querySelector('.materials-modal-close');
    const overlay = modal?.querySelector('.materials-modal-overlay');
    
    if (!modal || !openBtn) return;
    
    // Open modal
    openBtn.addEventListener('click', function(e) {
      e.preventDefault();
      modal.style.display = 'flex';
      modal.classList.add('active');
      document.body.style.overflow = 'hidden';
    });
    
    // Close modal functions
    function closeModal() {
      modal.classList.remove('active');
      setTimeout(() => {
        modal.style.display = 'none';
      }, 300);
      document.body.style.overflow = '';
    }
    
    // Close button
    closeBtn?.addEventListener('click', closeModal);
    
    // Overlay click
    overlay?.addEventListener('click', closeModal);
    
    // ESC key
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape' && modal.classList.contains('active')) {
        closeModal();
      }
    });
  }
  
  // Initialize when DOM is ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initMaterialsModal);
  } else {
    initMaterialsModal();
  }
})();
</script>