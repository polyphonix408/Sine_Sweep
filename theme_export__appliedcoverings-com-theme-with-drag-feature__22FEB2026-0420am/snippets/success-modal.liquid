{% comment %}
  Success Modal Snippet

  Usage:
  {% render 'success-modal' %}

  Example usage in parent component:
  this.successModal = document.querySelector('success-modal');
  this.successModal.show();
  this.successModal.hide();
{% endcomment %}

<success-modal>
  <div id="success-modal" class="modal-overlay" style="display: none;">
    <div class="modal-content">
      <div class="modal-icon success-icon">
        <svg width="64" height="64" viewBox="0 0 64 64" fill="none">
          <circle cx="32" cy="32" r="30" stroke="#4CAF50" stroke-width="4" />
          <path d="M20 32L28 40L44 24" stroke="#4CAF50" stroke-width="4" stroke-linecap="round"
            stroke-linejoin="round" />
        </svg>
      </div>
      <h2 class="modal-title">Request Submitted Successfully!</h2>
      <p class="modal-text">Thank you for your submission. We've received your file and details.</p>
      <p class="modal-text">We'll review everything and send you a custom quote within 24 hours.</p>
      <button type="button" id="close-modal-btn" class="btn btn--primary">Close</button>
    </div>
  </div>
</success-modal>

<script>
  if (!customElements.get('success-modal')) {
    class SuccessModal extends HTMLElement {
      constructor() {
        super();
        this.root = this.querySelector('#success-modal');
        this.closeBtn = this.querySelector('#close-modal-btn');
        this.modalContent = this.querySelector('.modal-content');

        this.attachEventListeners();
      }

      show() {
        this.root.style.display = 'flex';
        this.dispatchEvent(new CustomEvent('MODAL_SHOW', { bubbles: true }));
      }

      hide() {
        this.root.style.display = 'none';
        this.dispatchEvent(new CustomEvent('MODAL_CLOSE', { bubbles: true }));
      }

      attachEventListeners() {
        this.root.addEventListener('click', (e) => {
          if (!this.modalContent.contains(e.target)) {
            this.hide();
          }
        });
        this.closeBtn?.addEventListener('click', () => this.hide());
      }
    }
    customElements.define('success-modal', SuccessModal);
  }
</script>
