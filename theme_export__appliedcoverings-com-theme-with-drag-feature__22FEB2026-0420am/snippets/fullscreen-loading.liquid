{% comment %}
  Fullscreen Loading Indicator

  Usage:
  {% render 'fullscreen-loading', id: 'unique-id', message: 'Loading...' %}

  Parameters:
  - id: (optional) Unique identifier for this loading overlay
  - message: (optional) Custom loading message to display

  JavaScript:
  // Show loading
  document.getElementById('fullscreen-loading').classList.add('active');

  // Hide loading
  document.getElementById('fullscreen-loading').classList.remove('active');
{% endcomment %}

{%- liquid
  assign loading_id = id | default: "fullscreen-loading"
  assign loading_message = message | default: "Loading..."
  assign default_active = active | default: false
-%}

<fullscreen-loading id="{{ loading_id }}">
  <div class="fullscreen-loading-overlay {% if default_active %}active{% endif %}">
    <div class="fullscreen-loading-content">
      <div class="fullscreen-loading-spinner"></div>
      <p class="fullscreen-loading-message">{{ loading_message }}</p>
    </div>
  </div>
</fullscreen-loading>

<script type="module" src="{{ 'fullscreen-loading.js' | asset_url }}"></script>

<style>
  .fullscreen-loading-overlay {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    background: rgb(255, 255, 255);
    display: none;
    align-items: center;
    justify-content: center;
    z-index: 9999;
  }

  .fullscreen-loading-overlay.active {
    display: flex;
  }

  .fullscreen-loading-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    padding: 40px;
  }

  .fullscreen-loading-spinner {
    width: 60px;
    height: 60px;
    border: 5px solid #e0e0e0;
    border-top-color: #1897aa;
    border-radius: 50%;
    animation: fullscreen-spinner-rotate 1s linear infinite;
  }

  @keyframes fullscreen-spinner-rotate {
    0% {
      transform: rotate(0deg);
    }

    100% {
      transform: rotate(360deg);
    }
  }

  .fullscreen-loading-message {
    margin: 0;
    font-size: 18px;
    font-weight: 500;
    color: #333;
    text-align: center;
  }
</style>
