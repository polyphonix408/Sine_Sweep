{% comment %}
  Product Get Started Button
  Launches the wallpaper configurator instead of adding to cart
{% endcomment %}

<!-- Get Started button - custom wrapper to avoid Alpine.js initialization -->
<div class="configurator-launch-block"
     data-no-alpine="true"
     style="--PB: {{ block.settings.padding_bottom }}px;"
     {{ block.shopify_attributes }}>
  <div class="configurator-launch-wrapper">
    <div class="configurator-launch-buttons">
      <button
        type="button"
        id="launch-configurator-btn"
        class="btn--outline btn--full btn--primary"
        data-launch-configurator
        data-product-id="{{ product.id }}"
        data-pattern-url="{% if product.metafields.custom.pattern_file.value %}{{ product.metafields.custom.pattern_file.value | image_url: width: 2048 }}{% elsif product.featured_image %}{{ product.featured_image | image_url: width: 2048 }}{% endif %}"
        data-pattern-name="{{ product.title | escape }}"
      >
        <span class="btn-state-ready">
          {{ block.settings.button_text | default: 'Get Started - Customize Your Wallpaper' }}
        </span>
      </button>
    </div>
  </div>
</div>

<script>
  // Patch Alpine's productAddButtonForm to handle missing button gracefully
  document.addEventListener('DOMContentLoaded', function() {
    if (window.Alpine && window.productAddButtonForm) {
      const originalForm = window.productAddButtonForm;
      window.productAddButtonForm = function(options) {
        const instance = originalForm(options);
        const originalInit = instance.init;

        // Override init to check if button exists
        instance.init = function() {
          if (this.button) {
            originalInit.call(this);
          } else {
            console.log('Alpine: Skipping init for element without button (likely Get Started button)');
          }
        };

        return instance;
      };
    }
  });
</script>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const launchBtn = document.getElementById('launch-configurator-btn');
    const mainContent = document.querySelector('main') || document.querySelector('[role="main"]');
    const configuratorWrapper = document.getElementById('configurator-wrapper');
    const productId = '{{ product.id }}';
    const storageKey = `pattern_product_view_${productId}`;

    // Function to show configurator (takes over entire page)
    function showConfigurator() {
      // Hide all main content sections
      if (mainContent) {
        const sections = mainContent.querySelectorAll('section, .shopify-section');
        sections.forEach(section => {
          // Don't hide the configurator section itself
          if (!section.contains(configuratorWrapper)) {
            section.style.display = 'none';
          }
        });
      }

      // Show configurator
      if (configuratorWrapper) {
        configuratorWrapper.style.display = 'block';
        configuratorWrapper.style.minHeight = 'calc(100vh - 200px)'; // Account for header/footer
      }

      // Save state
      sessionStorage.setItem(storageKey, 'configurator');
      window.scrollTo(0, 0);
    }

    // Function to show marketing (restore all sections)
    function showMarketing() {
      // Show all main content sections
      if (mainContent) {
        const sections = mainContent.querySelectorAll('section, .shopify-section');
        sections.forEach(section => {
          section.style.display = '';
        });
      }

      // Hide configurator
      if (configuratorWrapper) {
        configuratorWrapper.style.display = 'none';
      }

      // Save state
      sessionStorage.setItem(storageKey, 'marketing');
      window.scrollTo(0, 0);
    }

    // Check saved state on page load
    const savedView = sessionStorage.getItem(storageKey);
    if (savedView === 'configurator') {
      // User was in configurator before refresh
      showConfigurator();
    }

    // Handle Get Started button click
    if (launchBtn) {
      launchBtn.addEventListener('click', function() {
        showConfigurator();
        console.log('Launching configurator for pattern:', this.dataset.patternName);
      });
    }

    // Update back button handler if it exists
    const backBtn = document.getElementById('back-to-product');
    if (backBtn) {
      backBtn.addEventListener('click', function() {
        showMarketing();
      });
    }
  });
</script>