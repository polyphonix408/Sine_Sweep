{% comment %}
  Wallpaper Configurator - Unified Snippet
  Parameters:
  - force_pattern_mode: boolean to lock in pattern mode
  - force_mural_mode: boolean to lock in mural/full image mode
  - product: product object

  Display Modes:
  - Pattern only: force_pattern_mode = true
  - Mural only: force_mural_mode = true
  - Customizer: Both false (shows toggle)
{% endcomment %}

{{ "wallpaper-configurator-v2.css" | asset_url | stylesheet_tag }}

<wallpaper-configurator>
  <div
    id="wallpaper-configurator"
    class="wallpaper-configurator page-width wrapper"
    data-product-id="{{ product.id }}"
    {% if force_pattern_mode %}
      data-force-pattern-mode="true"
    {% elsif force_mural_mode %}
      data-force-mural-mode="true"
    {% endif %}

    {% comment %} Auto-load images for both pattern and mural modes {% endcomment %}
    {% if force_pattern_mode or force_mural_mode %}
      {% comment %} Check for pattern/mural in metafields or use product featured image {% endcomment %}
      {% assign pattern_url = blank %}

      {% comment %} Debug: show what's in the metafield {% endcomment %}

      {% comment %} Try different ways to get the pattern URL {% endcomment %}

      {% comment %} PRIORITY 1: Check for pattern_file metafield {% endcomment %}
      {% if product.metafields.custom.pattern_file.value != blank %}
        {% assign file_value = product.metafields.custom.pattern_file.value %}

        {% comment %} Check if it's an object (PDF/generic file) or string (SVG/image) {% endcomment %}
        {% if file_value.url %}
          {% comment %} It's a file object with .url property (PDF, etc.) {% endcomment %}
          {% assign pattern_url = file_value.url %}
          {% if file_value.preview_image %}
            {% assign preview_url = file_value.preview_image.src %}
          {% endif %}
        {% else %}
          {% comment %} It's a direct URL string (SVG/image) {% endcomment %}
          {% if file_value contains ".svg" %}
            {% comment %} SVG: Convert to PNG for canvas rendering {% endcomment %}
            {% assign pattern_url = file_value | image_url: width: 2048, format: "png" %}
            {% assign pattern_original_svg = file_value | image_url %}
          {% else %}
            {% comment %} Regular image: Use high res version {% endcomment %}
            {% assign pattern_url = file_value | image_url: width: 2048 %}
          {% endif %}
        {% endif %}

        {% comment %} Also try .value.url in case it's a file metafield {% endcomment %}
        {% if pattern_url == blank and product.metafields.custom.pattern_file.value.url %}
          {% assign pattern_url = product.metafields.custom.pattern_file.value.url %}
        {% endif %}

        {% comment %} Store preview for reference {% endcomment %}
        {% if product.metafields.custom.pattern_file.value.preview_image %}
          {% assign preview_url = product.metafields.custom.pattern_file.value.preview_image.src %}
        {% endif %}

        {% comment %} PRIORITY 2: Check for direct URL metafield {% endcomment %}
      {% elsif product.metafields.custom.pattern_url != blank %}
        {% assign pattern_url = product.metafields.custom.pattern_url %}

        {% comment %} PRIORITY 3: Check for S3 URL {% endcomment %}
      {% elsif product.metafields.custom.pattern_s3_url != blank %}
        {% assign pattern_url = product.metafields.custom.pattern_s3_url %}
      {% elsif product.metafields.custom.pattern_file %}
        {% comment %} Fallback: try different ways to get the file {% endcomment %}
        {% assign file_ref = product.metafields.custom.pattern_file %}
        {% if file_ref contains "cdn.shopify.com" %}
          {% comment %} Direct CDN URL - use as is {% endcomment %}
          {% assign pattern_url = file_ref %}
        {% elsif file_ref contains ".pdf"
          or file_ref contains ".tiff"
          or file_ref contains ".tif"
          or file_ref contains ".svg"
        %}
          {% comment %} File reference that needs file_url filter (PDF, TIFF, SVG) {% endcomment %}
          {% assign pattern_url = file_ref | file_url %}
        {% else %}
          {% comment %} Regular image - use image_url filter {% endcomment %}
          {% assign pattern_url = file_ref | image_url: width: 2048 %}
        {% endif %}
      {% elsif product.metafields.custom.pattern_s3_url %}
        {% assign pattern_url = product.metafields.custom.pattern_s3_url %}
      {% elsif product.featured_image %}
        {% assign pattern_url = product.featured_image | image_url: width: 2048 %}
      {% endif %}

      {% if pattern_url != blank %}
        data-pattern-url="{{ pattern_url }}"
        data-pattern-name="{{ product.title | escape }}"
        {% if pattern_original_svg %}
          data-pattern-svg-url="{{ pattern_original_svg }}"
        {% endif %}
        {% comment %} Debug: Show both URLs to verify we're using the right one {% endcomment %}
        data-actual-file-url="{{ pattern_url | escape }}"
        {% if preview_url %}
          data-shopify-preview-url="{{ preview_url | escape }}"
        {% endif %}
      {% else %}
        {% comment %} Debug: Show what metafield value we're getting {% endcomment %}
        data-debug-metafield="{{ product.metafields.custom.pattern_file | escape }}"
        data-debug-no-pattern-url="true"
      {% endif %}
    {% else %}
      {% comment %} Standard mode with pattern toggle {% endcomment %}
      {% if product.metafields.custom.pattern_s3_url %}
        data-pattern-url="{{ product.metafields.custom.pattern_s3_url }}"
        data-pattern-name="{{ product.title | escape }}"
      {% endif %}
    {% endif %}
  >
    <div class="configurator-grid">
      <!-- Left Column: Canvas Area -->
      <div class="configurator-left">
        <!-- Upload Canvas Area -->
        <div class="upload-canvas">
          <div id="upload-zone" class="upload-dropzone">
            <input
              type="file"
              id="image-upload"
              class="file-input"
              accept=".jpg,.jpeg,.tiff,.tif,.pdf"
              style="display: none;"
            >

            <label for="image-upload" class="upload-label">
              <svg class="upload-icon" width="48" height="48" viewBox="0 0 48 48" fill="currentColor">
                <path d="M24 32L16 24L20 24L20 16L28 16L28 24L32 24L24 32Z" />
                <path d="M8 40C6 40 4 38 4 36L4 12C4 10 6 8 8 8L40 8C42 8 44 10 44 12L44 36C44 38 42 40 40 40L8 40Z"
                  fill="none" stroke="currentColor" stroke-width="2" />
              </svg>
              <span class="upload-text">Click or Drag & Drop to Upload Image</span>
              <span class="upload-info">📁 We accept .jpg, .tiff, or .pdf files.</span>
            </label>
          </div>

          <!-- Image Preview (hidden initially) -->
          <div
            id="preview-area"
            class="image-preview"
            style="display: none; position: relative; overflow: hidden; cursor: grab;"
          >
            <canvas
              id="pattern-canvas"
              style="display: none; width: 100%; max-width: 100%; transform-origin: center center; transition: transform 0.2s ease;"
            ></canvas>
            <img id="preview-image" src="" alt="Preview" style="display: none;">
            <div class="preview-actions">
              <!-- Remove button hidden for pattern products in forced mode -->
              <button
                type="button"
                id="clear-image"
                class="utility-btn btn--secondary"
                {% if force_pattern_mode %}
                  style="display: none;"
                {% endif %}
              >
                Remove Image
              </button>
              <!-- Re-crop hidden for pattern-only mode -->
              <button
                type="button"
                id="recrop-image"
                class="utility-btn btn--secondary"
                {% if force_pattern_mode %}
                  style="display: none;"
                {% endif %}
              >
                Re-crop Image
              </button>
            </div>
            <!-- Zoom controls DISABLED FOR NOW -->
            {% comment %}
              <div class="canvas-zoom-controls" style="position: absolute; bottom: 10px; right: 10px; background: rgba(255,255,255,0.9); padding: 5px; border-radius: 4px; display: none;">
                <button type="button" id="canvas-zoom-out" class="btn btn--secondary" style="padding: 2px 8px; font-size: 18px;">−</button>
                <span style="margin: 0 5px; font-size: 12px;"><span id="canvas-zoom-level">100%</span></span>
                <button type="button" id="canvas-zoom-in" class="btn btn--secondary" style="padding: 2px 8px; font-size: 18px;">+</button>
                <button type="button" id="canvas-zoom-reset" class="btn btn--secondary" style="margin-left: 5px; padding: 2px 8px; font-size: 12px;">Reset</button>
              </div>
            {% endcomment %}
          </div>

          <!-- Pattern drag hint -->
          <p id="pattern-drag-hint" class="pattern-drag-hint" style="display:none;">
            Click and drag to reposition pattern
          </p>

          <!-- Cropping Interface (hidden for pattern-only products) -->
          <div
            id="cropping-area"
            class="cropping-interface"
            style="display: none;"
            {% if force_pattern_mode %}
              data-hidden-for-patterns="true"
            {% endif %}
          >
            <div class="crop-container">
              <img id="crop-image" src="" alt="Crop">
            </div>
            <div class="crop-actions">
              <button type="button" id="cancel-crop" class="btn btn--secondary">Cancel</button>
              <button type="button" id="apply-crop" class="btn btn--primary">Apply Crop</button>
            </div>
          </div>
        </div>

        <!-- Bottom Cards Area -->
        <div class="bottom-cards-container">
          <!-- Image Quality Card (shown for mural mode) -->
          <div
            class="quality-card control-card bottom-card"
            {% if force_pattern_mode %}
              style="display: none;"
            {% endif %}
          >
            <h4 class="bottom-card-title">Image Quality</h4>
            <div class="quality-rows">
              <div class="quality-row">
                <span class="quality-label">DPI</span>
                <span id="quality-dpi" class="quality-value">0</span>
              </div>
              <div class="quality-row">
                <span class="quality-label">Image Quality</span>
                <span id="quality-score" class="quality-value">No Image</span>
              </div>
            </div>
          </div>

          <!-- Crop Helper Card (shown for mural mode during cropping) -->
          <div
            class="crop-helper-card control-card bottom-card"
            {% if force_pattern_mode %}
              style="display: none;"
            {% endif %}
          >
            <h4 class="bottom-card-title">Crop Helper</h4>
            <p class="helper-text">Grab, drag, and resize the crop box to set your crop zone</p>
          </div>

          <!-- Upload Help Card -->
          <div class="upload-help-card control-card bottom-card">
            <h4 class="bottom-card-title">Need Help With FIle Upload or Special Request?</h4>
            <p class="help-text">We accept .jpg, .png, .tiff, or .pdf files under 1GB.</p>
            <p class="help-text">
              For files over 1GB or different file types (.psd, .ai, .eps, .psb), please click the link below.
            </p>
            <a class="btn btn--primary" href="/pages/upload-your-own-image" target="_blank">Click here</a>
          </div>
        </div>
      </div>

      <!-- Right Column: Control Cards -->
      <div class="configurator-right">
        <!-- Step 1: Enter Your Dimensions -->
        <div class="dimensions-card control-card">
          <h3 class="card-title">Step 1: Enter Your Dimensions</h3>
          <button id="measure-modal-btn" type="button" class="material-info-btn" title="How to measure your walls">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor">
              <circle cx="8" cy="8" r="7" fill="none" stroke="currentColor" stroke-width="1.5" />
              <text x="8" y="11" text-anchor="middle" font-size="10">i</text>
            </svg>
            <span>How to measure your walls</span>
          </button>
          <div class="dimensions-inputs">
            <div class="dimension-group">
              <label for="width-feet">Width</label>
              <div class="dimension-row">
                <input
                  type="number"
                  id="width-feet"
                  class="dimension-input"
                  min="0"
                  max="100"
                  value="0"
                  placeholder="0"
                >
                <span class="dimension-unit">ft</span>
                <input
                  type="number"
                  id="width-inches"
                  class="dimension-input"
                  min="0"
                  max="11"
                  value="0"
                  placeholder="0"
                >
                <span class="dimension-unit">in</span>
              </div>
            </div>

            <div class="dimension-group">
              <label for="height-feet">Height</label>
              <div class="dimension-row">
                <input
                  type="number"
                  id="height-feet"
                  class="dimension-input"
                  min="0"
                  max="100"
                  value="0"
                  placeholder="0"
                >
                <span class="dimension-unit">ft</span>
                <input
                  type="number"
                  id="height-inches"
                  class="dimension-input"
                  min="0"
                  max="11"
                  value="0"
                  placeholder="0"
                >
                <span class="dimension-unit">in</span>
              </div>
            </div>
          </div>
          <small class="disclaimer"
            >Please add 4" to both height and width for bleed. This ensures a smooth install and accounts for uneven
            walls --even perfectly square walls. walls still need the extra bleed.</small
          >
        </div>

        <!-- Step 2: Select Your Material -->
        <div class="materials-card control-card">
          <h3 class="card-title">Step 2: Select Your Material</h3>

          <div class="material-controls">
            <button id="compare-materials-btn" type="button" class="material-info-btn" title="Compare materials">
              <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor">
                <circle cx="8" cy="8" r="7" fill="none" stroke="currentColor" stroke-width="1.5" />
                <text x="8" y="11" text-anchor="middle" font-size="10">i</text>
              </svg>
              <span>COMPARE MATERIALS</span>
            </button>

            <select id="material-select" class="material-select">
              <option value="" disabled selected>Select a Material</option>
              {% for variant in product.variants %}
                {% unless variant.title contains "Sample" %}
                  <option
                    value="{{ variant.id }}"
                    data-price="{{ variant.price | divided_by: 100.00 }}"
                    {% if forloop.first %}
                      selected
                    {% endif %}
                  >
                    {{ variant.title | remove: "/ Custom" }}
                  </option>
                {% endunless %}
              {% endfor %}
            </select>
          </div>
        </div>

        <!-- Step 3: More Options -->
        <div class="options-card control-card">
          <h3 class="card-title">Step 3: More Options</h3>

          <!-- Mode Toggle (only shown in customizer mode - when neither mode is forced) -->
          {% comment %}
            {% unless force_pattern_mode or force_mural_mode %}
            <div class="mode-toggle-controls">
              <label class="mode-label">IMAGE MODE</label>
              <div class="mode-toggle-buttons">
                <button type="button" id="mode-single-btn" class="mode-toggle-btn active" data-mode="single">
                  <span>FULL IMAGE</span>
                </button>
                <button type="button" id="mode-pattern-btn" class="mode-toggle-btn" data-mode="pattern">
                  <span>PATTERN/TILE</span>
                </button>
              </div>
            </div>
            {% endunless %}
          {% endcomment %}

          <div class="option-buttons">
            {% unless force_pattern_mode or force_mural_mode %}
              <button type="button" id="mode-pattern-btn" class="utility-btn" data-mode="pattern">PATTERN</button>
            {% endunless %}
            <button type="button" id="mirror-btn" class="utility-btn">MIRROR</button>
            <button type="button" id="bw-btn" class="utility-btn">B&W</button>
            <button type="button" id="reset-position-btn" class="utility-btn">RESET POSITION</button>
            {% comment %} <button type="button" id="reset-all-btn" class="utility-btn">RESET ALL</button> {% endcomment %}
          </div>

          <!-- Pattern Size Controls -->
          <div
            id="pattern-settings"
            class="pattern-settings"
            style="display: {% if force_pattern_mode %}block{% elsif force_mural_mode %}none{% else %}none{% endif %};"
          >
            <div class="pattern-size-control">
              <label class="size-label">Pattern Size: <span id="pattern-size-value">24"</span></label>
              <input type="range" id="pattern-size-slider" class="pattern-slider" min="12" max="96" value="24" step="1">
              <div class="size-hints">
                <span class="hint-small">12"</span>
                <span class="hint-large">Max</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Order Summary Card -->
        <div class="summary-card control-card">
          <h3 class="card-title">Order Summary</h3>

          <div class="summary-rows">
            <div class="summary-row">
              <span class="summary-label">Material</span>
              <span id="summary-material" class="summary-value">Select a Material</span>
            </div>

            <div class="summary-row">
              <span class="summary-label">Dimensions</span>
              <span id="summary-dimensions" class="summary-value">0.0' × 0.0'</span>
            </div>

            <div class="summary-row">
              <span class="summary-label">Total area</span>
              <span id="summary-area" class="summary-value">0 sq ft</span>
            </div>

            <div class="summary-row">
              <span class="summary-label">Image</span>
              <span id="summary-image" class="summary-value">No Image</span>
            </div>

            <div class="summary-row summary-total">
              <span class="summary-label">Total Price</span>
              <span id="summary-price" class="summary-value">$0.00</span>
            </div>
          </div>

          <button
            type="button"
            id="add-to-cart-button"
            class="btn btn--full btn--primary btn--add-to-cart"
            disabled
          >
            {% render "icon-set-classic-cart" %}
            <span>Add To Cart</span>
          </button>
        </div>
      </div>
    </div>

    <!-- Hidden inputs for form data -->
    <input type="hidden" id="input-square-footage" name="square_footage" value="0">
    <input type="hidden" id="input-calculated-price" name="calculated_price" value="0">
    <input type="hidden" id="mirror-input" name="mirror" value="0">
    <input type="hidden" id="black-and-white-input" name="black_and_white" value="0">
  </div>

  <script type="application/json" id="data">
    {
      "product": {{ product | json }},
      "force_pattern_mode": {{ force_pattern_mode | json }},
      "force_mural_mode": {{ force_mural_mode | json }},
      "pattern_url": {{ pattern_url | json }},
      "template": {{ template | json }}
    }
  </script>
</wallpaper-configurator>
<!-- Materials Comparison Modal -->
{% render "wallpaper-materials-modal", product: product %}

<!-- How to Measure Your Walls Modal -->
{% render "wallpaper-measure-walls-modal" %}

<!-- Load required libraries -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/cropperjs@1.5.13/dist/cropper.min.css">
<script src="https://cdn.jsdelivr.net/npm/cropperjs@1.5.13/dist/cropper.min.js"></script>
<!-- TIFF support using UTIF library -->
<script src="{{ 'utif.js' | asset_url }}"></script>
<script>
  // Verify TIFF library loaded
  window.addEventListener('load', function () {
    if (typeof UTIF !== 'undefined') {
      console.log('✅ UTIF library loaded successfully for TIFF support');
    } else {
      console.error('❌ UTIF library failed to load');
    }
  });
</script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"></script>
<script>
  // Configure PDF.js worker
  pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';
</script>
<script type="module" src="{{ 'wallpaper-s3-integration.js' | asset_url }}"></script>
<script type="module" src="{{ 'wallpaper-configurator.js' | asset_url }}"></script>
