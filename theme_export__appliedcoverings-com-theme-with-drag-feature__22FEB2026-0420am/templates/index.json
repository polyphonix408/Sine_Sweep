:{"type":"icon_block","settings":{"icon_name":"icon-basket-return","icon_alt":"shopify:\/\/shop_images\/MADE_IN_USA_ICON_671945e4-7c1e-4fb3-9e4c-af59352c364d.png","icon_color":"#aaaaaa","title":"Made In The USA","text":"<p>Every wallpaper and mural is printed in the USA by experienced artists and print specialists, ensuring consistent quality, careful craftsmanship, and reliable production from start to finish.<\/p>","link_text":"","link_url":""}},"icon_block_kxWP38":{"type":"icon_block","settings":{"icon_name":"icon-shipment-world","icon_alt":"shopify:\/\/shop_images\/LEED_ICON_4cb08f1b-439c-495d-a759-341fac036804.png","icon_color":"#aaaaaa","title":"Eco-Certified Materials","text":"<p>Printed using LEED Platinum–compliant materials and inks, our wallpapers and murals support eco-certified interiors for commercial, hospitality, healthcare, and residential environments.<\/p>","link_text":"","link_url":""}},"icon_block_38Jw7L":{"type":"icon_block","settings":{"icon_name":"icon-phone","icon_alt":"shopify:\/\/shop_images\/PRECISION_ICON_4d1a006c-9113-4383-8329-8363ed5bba6a.png","icon_color":"#aaaaaa","title":"Perfect Fit Every Time","text":"<p>Each wallpaper and mural is printed to your exact wall dimensions, eliminating waste, trimming, and guesswork—just a precise, made-to-measure fit every time.<\/p>","link_text":"","link_url":""}}},"block_order":["icon_block_qiUMMk","icon_block_kxWP38","icon_block_38Jw7L"],"name":"Icon columns","settings":{"title":"","bg":"palette--light bg--neutral","icons_size":100,"icon_alignment":"icon--top","layout":"grid--stacked","align_text":"text-center","width":"wrapper","padding_top":80,"padding_bottom":80}},"section_custom_content_6xFGNW":{"type":"section-custom-content","blocks":{"text_tgcNYi":{"type":"text","settings":{"kicker":"","title":"","text":"<h3>Custom Wallpaper for Homes & Commercial Interiors<br\/><\/h3><h3><\/h3><p>Our custom printed wallpaper and murals are designed for both residential and commercial spaces, giving you complete control over how your walls look and fit. Whether you’re decorating a home, office, hotel, retail space, or hospitality interior, we print every design to your exact wall size for a seamless, professional finish with no excess material.<\/p><p>Using our online editor, you can preview your wallpaper before it’s printed, resize the design to suit your space, and ensure the pattern or image looks exactly right at full scale. We offer durable, high-quality materials suitable for high-traffic commercial environments as well as refined finishes for residential interiors. The result is a made-to-measure wallcovering that’s easy to install, visually accurate, and tailored specifically to your space.<br\/><br\/><\/p><ul><li>Printed to exact wall dimensions for a precise fit<\/li><li>Suitable for homes, offices, hotels, retail, and hospitality spaces<\/li><li>Durable material options for commercial interiors<\/li><li>Live preview and design adjustments before printing<\/li><\/ul>","font_size":4,"text_columns":1,"align_text":"text-left","button_text":"LEARN MORE","button_url":"shopify:\/\/pages\/about","button_color":"btn--neutral","button_style":"btn btn--long","text_color":"text--neutral","bg_color":"#f7f5f4"}},"video_LFtAhK":{"type":"video","settings":{"object_position":"center-center","image":"shopify:\/\/shop_images\/Wallpaper_Done_Right_SJ.png","video_link":"","popup_text":"","kicker":"","title":"","richtext":"","text_align":"align--middle-center","text_color":"text--white","overlay_opacity":0,"overlay_color":"#000000","link_text":"","link":"","button_color":"btn--white","button_style":"btn--soft"}}},"block_order":["text_tgcNYi","video_LFtAhK"],"settings":{"height":"use_image","brick_gutter":0,"borders":false,"bg_color":"","preload_image":false,"width":"wrapper","padding_top":38,"padding_bottom":38}},"section_mosaic_HPhGBQ":{"type":"section-mosaic","blocks":{"collection_UfW8Hz":{"type":"collection","settings":{"collection":"nature","kicker":"","kicker_size":3,"sho