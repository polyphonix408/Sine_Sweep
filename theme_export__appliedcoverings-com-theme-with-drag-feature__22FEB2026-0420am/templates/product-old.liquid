{% comment %}
  Pattern Product Template - Marketing + Configurator
  Shows marketing page first, then launches configurator
{% endcomment %}

<!-- Marketing Section (visible by default) -->
{% render 'pattern-product-marketing', product: product %}

<!-- Configurator Section (hidden by default) -->
<div id="wallpaper-configurator" style="display: none;">
  {% render 'wallpaper-configurator', product: product, force_pattern_mode: true %}
</div> 