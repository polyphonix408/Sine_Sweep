-thick-line","text_color":"text--neutral","bg_color":"#ffffff"}},"custom-content-1-0":{"type":"video","settings":{"object_position":"center-center","image":"shopify:\/\/shop_images\/FROM_CONCEPT_TO_CREATION.png","video_link":"","popup_text":"Learn our story","kicker":"","title":"","richtext":"","text_align":"align--middle-center","text_color":"text--white","overlay_opacity":0,"overlay_color":"#000000","link_text":"","link":"","button_color":"btn--white","button_style":"btn"}}},"block_order":["custom-content-1-1","custom-content-1-0"],"settings":{"height":"use_image","brick_gutter":0,"borders":false,"bg_color":"","preload_image":false,"width":"wrapper","padding_top":50,"padding_bottom":0}},"custom-content-2":{"type":"section-custom-content","blocks":{"custom-content-2-1":{"type":"video","settings":{"object_position":"center-center","image":"shopify:\/\/shop_images\/PRINTING_EXPERTS.png","video_link":"","popup_text":"","kicker":"","title":"","richtext":"","text_align":"align--middle-center","text_color":"text--white","overlay_opacity":0,"overlay_color":"#000000","link_text":"","link":"","button_color":"btn--white","button_style":"btn--soft"}},"custom-content-2-0":{"type":"text","settings":{"kicker":"","title":"Your Experts in Wallpaper Printing","text":"<p>At Applied Coverings, our team of printing specialists is the backbone of everything we do. We bring deep expertise in custom wallpaper and large-format printing, delivering precision-crafted solutions for commercial and residential environments.<\/p><p>From concept to completion, we offer a full range of services — including design, production, and installation support — to ensure every project meets the highest standards of quality and impact.We believe great results come from true collaboration. Our designers and technicians work closely with you to turn your vision into bold, visual experiences that reflect your purpose and personality.<\/p>","font_size":4,"text_columns":1,"align_text":"text-left","button_text":