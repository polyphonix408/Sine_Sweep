{% comment %}
  Wallpaper Configurator Section
  Adds an H1 that shows on the product.wallpaper template.
{% endcomment %}

<div id="configurator-wrapper" style="{% if section.settings.start_hidden %}display: none;{% endif %}">
  {% if template.suffix == 'wallpaper' and section.settings.h1_text != blank %}
    <h1 class="custom-upload-h1">{{ section.settings.h1_text | escape }}</h1>
  {% endif %}

  {% if section.settings.show_back_button %}
    <button type="button" id="back-to-product" class="btn btn--secondary" style="margin-bottom: 0px;">
      ← Back to Product Details
    </button>
  {% endif %}

  {% comment %}
    Check metafield first, then fall back to section settings
    Metafield values: 'Pattern', 'Mural', or blank for full customizer
  {% endcomment %}
  {% assign customizer_mode = product.metafields.custom.customizer_mode.value | default: product.metafields.custom.customizer_mode %}

  {% if customizer_mode == 'Pattern' %}
    {% assign force_pattern = true %}
    {% assign force_mural = false %}
  {% elsif customizer_mode == 'Mural' %}
    {% assign force_pattern = false %}
    {% assign force_mural = true %}
  {% else %}
    {% assign force_pattern = section.settings.force_pattern_mode %}
    {% assign force_mural = section.settings.force_mural_mode %}
  {% endif %}

  {% render 'wallpaper-configurator',
    product: product,
    force_pattern_mode: force_pattern,
    force_mural_mode: force_mural
  %}
</div>

<style>
  .custom-upload-h1{
    font-size: 32px;
    line-height: 1.15;
    margin: 0 0 20px;
    text-align: center;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const backBtn = document.getElementById('back-to-product');
    const configuratorWrapper = document.getElementById('configurator-wrapper');
    const mainContent = document.querySelector('main') || document.querySelector('[role="main"]');
    const productId = '{{ product.id }}';
    const storageKey = `pattern_product_view_${productId}`;
    const isWallpaperTemplate = '{{ template.suffix }}' === 'wallpaper';

    // For wallpaper template, hide all sections except configurator immediately
    if (isWallpaperTemplate && !{{ section.settings.start_hidden }}) {
      if (mainContent) {
        const sections = mainContent.querySelectorAll('section, .shopify-section');
        sections.forEach(section => {
          if (!section.contains(configuratorWrapper)) {
            section.style.display = 'none';
          }
        });
      }

      if (configuratorWrapper) {
        configuratorWrapper.style.display = 'block';
        configuratorWrapper.style.minHeight = 'calc(100vh - 100px)';
      }

      setTimeout(() => {
        if (window.reinitWallpaperConfigurator) {
          window.reinitWallpaperConfigurator();
        }
      }, 100);
    }

    if (backBtn) {
      backBtn.addEventListener('click', function() {
        if (configuratorWrapper) {
          configuratorWrapper.style.display = 'none';
        }

        if (mainContent) {
          const sections = mainContent.querySelectorAll('section, .shopify-section');
          sections.forEach(section => {
            section.style.display = '';
          });
        }

        sessionStorage.setItem(storageKey, 'marketing');
        window.scrollTo(0, 0);
      });
    }
  });
</script>

{% schema %}
{
  "name": "Wallpaper Configurator",
  "settings": [
    {
      "type": "text",
      "id": "h1_text",
      "label": "H1 text (shows on product.wallpaper template)",
      "default": "Custom Wallpaper & Wall Murals Printed to Your Exact Wall Size"
    },
    {
      "type": "checkbox",
      "id": "force_pattern_mode",
      "label": "Force Pattern Mode",
      "info": "Lock to pattern/tile mode only",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "force_mural_mode",
      "label": "Force Mural Mode",
      "info": "Lock to full image mode only",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "start_hidden",
      "label": "Start Hidden",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_back_button",
      "label": "Show Back Button",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Wallpaper Configurator"
    }
  ]
}
{% endschema %}
