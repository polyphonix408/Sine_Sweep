{% comment %}
  Large File Upload Form
  For handling files >1GB and special file types
{% endcomment %}

{{ "large-file-upload.css" | asset_url | stylesheet_tag }}

<large-file-upload-form>
  <div id="large-file-upload-container" class="page-width wrapper">
    <div class="upload-form-grid">
      <!-- Left Column: File Upload & Info -->
      <div class="upload-left">
        <!-- File Upload Card -->
        <div class="upload-card control-card">
          <h3 class="card-title">Upload Your File</h3>
          <p class="card-description">We support TIFF, PSD, PSB, RAW, AI, EPS, PDF, JPG, JPEG, PNG files up to 5TB</p>

          <div class="file-upload-area">
            <input
              type="file"
              id="large-file-input"
              class="file-input-hidden"
              accept=".tif,.tiff,.psd,.psb,.raw,.ai,.eps,.pdf,.jpg,.jpeg,.png,.dng"
              style="display: none;"
            >

            <div id="file-drop-zone" class="file-drop-zone">
              <label for="large-file-input" class="file-drop-label">
                <svg
                  class="upload-icon"
                  width="64"
                  height="64"
                  viewBox="0 0 64 64"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <path d="M32 44V20M32 20L22 30M32 20L42 30" />
                  <path
                    d="M12 52H52C54.2091 52 56 50.2091 56 48V16C56 13.7909 54.2091 12 52 12H12C9.79086 12 8 13.7909 8 16V48C8 50.2091 9.79086 52 12 52Z" />
                </svg>
                <span class="upload-text-main">Click or Drag & Drop Your File Here</span>
                <span class="upload-text-sub">No size limit • All file formats supported</span>
              </label>
            </div>

            <!-- File Selected Display -->
            <div id="file-selected-info" class="file-selected-info" style="display: none;">
              <div class="file-info-content">
                <svg class="file-icon" width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M14 2H6C4.9 2 4 2.9 4 4V20C4 21.1 4.9 22 6 22H18C19.1 22 20 21.1 20 20V8L14 2Z" />
                  <path d="M14 2V8H20" fill="none" stroke="#fff" stroke-width="2" />
                </svg>
                <div class="file-details">
                  <div class="file-name" id="selected-file-name">filename.psd</div>
                  <div class="file-size" id="selected-file-size">0 MB</div>
                </div>
                <button type="button" id="remove-file-btn" class="remove-file-btn" title="Remove file">
                  <svg width="20" height="20" viewBox="0 0 20 20" fill="currentColor">
                    <path d="M15 5L5 15M5 5L15 15" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                  </svg>
                </button>
              </div>
            </div>

            <!-- Upload Progress -->
            <div id="upload-progress-container" class="upload-progress-container" style="display: none;">
              <div class="progress-info">
                <span class="progress-text">Uploading...</span>
                <span class="progress-percentage" id="upload-percentage">0%</span>
              </div>
              <div class="progress-bar-bg">
                <div class="progress-bar-fill" id="upload-progress-bar" style="width: 0%"></div>
              </div>
              <div class="progress-details">
                <span class="progress-speed" id="upload-speed">0 MB/s</span>
                <span class="progress-remaining" id="upload-remaining">Calculating...</span>
              </div>
            </div>

            <!-- Upload Success Message -->
            <div id="upload-success" class="upload-message upload-success" style="display: none;">
              <svg width="48" height="48" viewBox="0 0 48 48" fill="none">
                <circle cx="24" cy="24" r="22" stroke="#4CAF50" stroke-width="3" />
                <path d="M14 24L20 30L34 16" stroke="#4CAF50" stroke-width="3" stroke-linecap="round"
                  stroke-linejoin="round" />
              </svg>
              <p class="message-text">File uploaded successfully!</p>
            </div>

            <!-- Upload Error Message -->
            <div id="upload-error" class="upload-message upload-error" style="display: none;">
              <svg width="48" height="48" viewBox="0 0 48 48" fill="none">
                <circle cx="24" cy="24" r="22" stroke="#f44336" stroke-width="3" />
                <path d="M16 16L32 32M32 16L16 32" stroke="#f44336" stroke-width="3" stroke-linecap="round" />
              </svg>
              <p class="message-text" id="error-message-text">Upload failed. Please try again.</p>
            </div>
          </div>
        </div>

        <!-- Info Card -->
        <div class="info-card control-card">
          <h4 class="card-subtitle">Why Use This Form?</h4>
          <ul class="info-list">
            <li>✓ Upload files of any size (no 1GB limit)</li>
            <li>✓ Support for professional file formats (PSD, AI, EPS)</li>
            <li>✓ Secure cloud storage</li>
            <li>✓ Direct submission to our team</li>
          </ul>
          <p class="info-note">We'll review your file and dimensions, then send you a custom quote via email.</p>
        </div>
      </div>

      <!-- Right Column: Form Details -->
      <div class="upload-right">
        <!-- Customer Information -->
        <div class="customer-card control-card" id="customer-info">
          <h3 class="card-title">Your Information</h3>

          <div class="form-group">
            <label for="customer-name" class="form-label">Name <span class="required">*</span></label>
            <input type="text" id="customer-name" class="form-input" placeholder="Enter your full name" required>
          </div>

          <div class="form-group">
            <label for="Phone Number" class="form-label">Phone Number <span class="required">*</span></label>
            <input type="text" id="customer-phone" class="form-input" placeholder="123-555-5555" required>
          </div>

          <div class="form-group">
            <label for="customer-email" class="form-label">Email <span class="required">*</span></label>
            <input type="email" id="customer-email" class="form-input" placeholder="your@email.com" required>
          </div>
        </div>

        <!-- Wall Dimensions -->
        <div class="dimensions-card control-card">
          <h3 class="card-title">Wall Dimensions</h3>
          <p class="card-description">Enter your wall measurements</p>

          <div class="dimensions-inputs">
            <div class="dimension-group">
              <label for="wall-width-feet" class="form-label">Width</label>
              <div class="dimension-row">
                <input
                  type="number"
                  id="wall-width-feet"
                  class="dimension-input"
                  min="0"
                  max="100"
                  value=""
                  placeholder="0"
                >
                <span class="dimension-unit">ft</span>
                <input
                  type="number"
                  id="wall-width-inches"
                  class="dimension-input"
                  min="0"
                  max="11"
                  value=""
                  placeholder="0"
                >
                <span class="dimension-unit">in</span>
              </div>
            </div>

            <div class="dimension-group">
              <label for="wall-height-feet" class="form-label">Height</label>
              <div class="dimension-row">
                <input
                  type="number"
                  id="wall-height-feet"
                  class="dimension-input"
                  min="0"
                  max="100"
                  value=""
                  placeholder="0"
                >
                <span class="dimension-unit">ft</span>
                <input
                  type="number"
                  id="wall-height-inches"
                  class="dimension-input"
                  min="0"
                  max="11"
                  value=""
                  placeholder="0"
                >
                <span class="dimension-unit">in</span>
              </div>
            </div>
          </div>

          <div class="dimensions-summary">
            <span class="summary-label">Total area:</span>
            <span class="summary-value" id="total-area-display">0 sq ft</span>
          </div>
        </div>

        <!-- Material Selection -->
        <div class="material-card control-card">
          <h3 class="card-title">Material Preference</h3>

          <div class="form-group">
            <label for="material-select" class="form-label">Select Material <span class="required">*</span></label>
            <select id="material-select" class="form-select" required>
              <option value="">SELECT A MATERIAL</option>
              <option value="Pre-Pasted Wallpaper">Pre-Pasted Wallpaper</option>
              <option value="Peel & Stick Canvas">Peel & Stick Canvas</option>
              <option value="Peel & Stick Linen">Peel & Stick Linen</option>
              <option value="Terralon Smooth Type II">Terralon Smooth Type II</option>
              <option value="Suede Type II 20oz">Suede Type II 20oz</option>
              <option value="-Not Sure Need Help-">-Not Sure Need Help-</option>
            </select>
          </div>
        </div>

        <!-- Special Requests -->
        <div class="requests-card control-card">
          <h3 class="card-title">Special Requests & Comments</h3>

          <div class="form-group">
            <label for="special-requests" class="form-label">Additional Notes (Optional)</label>
            <textarea
              id="special-requests"
              class="form-textarea"
              rows="5"
              placeholder="Any special instructions, questions, or requests? Let us know here..."
            ></textarea>
          </div>
        </div>

        <!-- Submit Button -->
        <div class="submit-card">
          <button type="button" id="submit-upload-btn" class="btn btn--full btn--primary btn--add-to-cart" disabled>
            <span>Submit Request</span>
          </button>
          <p class="submit-note">We'll review your submission and send you a quote within 24 hours.</p>
        </div>
      </div>
    </div>
  </div>

  {% render "success-modal" %}
</large-file-upload-form>

<script type="module" src="{{ 'wallpaper-s3-integration.js' | asset_url }}" defer></script>
<script type="module" src="{{ 'large-file-upload.js' | asset_url }}" defer></script>

{% schema %}
  {
    "name": "Large File Upload Form",
    "tag": "section",
    "class": "section-large-file-upload",
    "settings": []
  }
{% endschema %}
