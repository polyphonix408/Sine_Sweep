{% doc %}
  @prompt
    make a custom rich text block that only shows up for this collection
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% liquid
  assign current_collection_handle = collection.handle
  assign target_collection_handle = block.settings.collection_handle
  assign show_block = false

  if current_collection_handle == target_collection_handle
    assign show_block = true
  endif
%}

{% if show_block %}
  {% style %}
    .ai-collection-richtext-{{ ai_gen_id }} {
      display: block;
      width: 100%;
      padding: {{ block.settings.padding_top }}px {{ block.settings.padding_horizontal }}px {{ block.settings.padding_bottom }}px;
      background-color: {{ block.settings.background_color }};
      text-align: {{ block.settings.text_alignment }};
    }

    .ai-collection-richtext__container-{{ ai_gen_id }} {
      max-width: {{ block.settings.max_width }}px;
      margin: 0 auto;
    }

    .ai-collection-richtext__content-{{ ai_gen_id }} {
      color: {{ block.settings.text_color }};
      font-size: {{ block.settings.font_size }}px;
      line-height: 1.6;
    }

    .ai-collection-richtext__content-{{ ai_gen_id }} h1,
    .ai-collection-richtext__content-{{ ai_gen_id }} h2,
    .ai-collection-richtext__content-{{ ai_gen_id }} h3,
    .ai-collection-richtext__content-{{ ai_gen_id }} h4,
    .ai-collection-richtext__content-{{ ai_gen_id }} h5,
    .ai-collection-richtext__content-{{ ai_gen_id }} h6 {
      color: {{ block.settings.heading_color }};
      margin-top: 0;
      margin-bottom: 16px;
    }

    .ai-collection-richtext__content-{{ ai_gen_id }} p {
      margin-top: 0;
      margin-bottom: 16px;
    }

    .ai-collection-richtext__content-{{ ai_gen_id }} p:last-child {
      margin-bottom: 0;
    }

    .ai-collection-richtext__content-{{ ai_gen_id }} a {
      color: {{ block.settings.link_color }};
      text-decoration: underline;
    }

    .ai-collection-richtext__content-{{ ai_gen_id }} a:hover {
      opacity: 0.8;
    }

    .ai-collection-richtext__content-{{ ai_gen_id }} ul,
    .ai-collection-richtext__content-{{ ai_gen_id }} ol {
      margin-top: 0;
      margin-bottom: 16px;
      padding-left: 24px;
    }

    .ai-collection-richtext__content-{{ ai_gen_id }} li {
      margin-bottom: 8px;
    }

    @media screen and (max-width: 749px) {
      .ai-collection-richtext-{{ ai_gen_id }} {
        padding: {{ block.settings.padding_top | times: 0.7 }}px {{ block.settings.padding_horizontal | times: 0.7 }}px {{ block.settings.padding_bottom | times: 0.7 }}px;
      }

      .ai-collection-richtext__content-{{ ai_gen_id }} {
        font-size: {{ block.settings.font_size | times: 0.9 }}px;
      }
    }
  {% endstyle %}

  <div class="ai-collection-richtext-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
    <div class="ai-collection-richtext__container-{{ ai_gen_id }}">
      {% if block.settings.content != blank %}
        <div class="ai-collection-richtext__content-{{ ai_gen_id }}">
          {{ block.settings.content }}
        </div>
      {% else %}
        <div class="ai-collection-richtext__content-{{ ai_gen_id }}">
          <p style="color: #999; font-style: italic;">Add your rich text content in the block settings. This block will only show for the "{{ target_collection_handle }}" collection.</p>
        </div>
      {% endif %}
    </div>
  </div>
{% endif %}

{% schema %}
{
  "name": "Collection rich text",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Collection targeting"
    },
    {
      "type": "text",
      "id": "collection_handle",
      "label": "Collection handle",
      "default": "geometric-abstract-wallpaper",
      "info": "Enter the collection handle (URL slug). This block will only display on that collection page."
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Rich text content",
      "default": "<p>Add your custom content here for this collection.</p>"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 400,
      "max": 1600,
      "step": 50,
      "unit": "px",
      "label": "Maximum width",
      "default": 1200
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Top padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Bottom padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_horizontal",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Horizontal padding",
      "default": 20
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#fdfdfd"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#375a5e"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Headings",
      "default": "#375a5e"
    },
    {
      "type": "color",
      "id": "link_color",
      "label": "Links",
      "default": "#748cab"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "font_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Font size",
      "default": 16
    }
  ],
  "presets": [
    {
      "name": "Collection rich text"
    }
  ]
}
{% endschema %}
