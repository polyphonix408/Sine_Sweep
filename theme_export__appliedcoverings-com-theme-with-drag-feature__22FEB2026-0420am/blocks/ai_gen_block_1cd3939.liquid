      "default": "#375a5e"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#375a5e"
    },
    {
      "type": "color",
      "id": "link_color",
      "label": "Link",
      "default": "#748cab"
    },
    {
      "type": "color",
