    },
    {
      "type": "header",
      "content": "Collection 3"
    },
    {
      "type": "collection",
      "id": "collection_3",
      "label": "Collection"
    },
    {
      "type": "text",
      "id": "collection_3_heading",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "collection_3_content",
      "label": "Content",
      "default": "<p>Add your custom text for this collection here.</p>"
