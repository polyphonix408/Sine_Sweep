{% doc %}
  @prompt
    custom text block for each collection that can have unique text for each collection. 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-collection-text-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: {{ block.settings.padding_top }}px {{ block.settings.padding_horizontal }}px {{ block.settings.padding_bottom }}px {{ block.settings.padding_horizontal }}px;
    background-color: {{ block.settings.background_color }};
  }

  @media screen and (min-width: 750px) {
    .ai-collection-text-{{ ai_gen_id }} {
      width: {{ block.settings.desktop_width_percent }}%;
    }
  }

  .ai-collection-text__container-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
    text-align: {{ block.settings.text_alignment }};
  }

  .ai-collection-text__heading-{{ ai_gen_id }} {
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
    margin: 0 0 {{ block.settings.heading_spacing }}px 0;
    font-family: {{ block.settings.heading_font.family }}, {{ block.settings.heading_font.fallback_families }};
    font-weight: {{ block.settings.heading_font.weight }};
    font-style: {{ block.settings.heading_font.style }};
  }

  .ai-collection-text__content-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.text_size }}px;
    line-height: {{ block.settings.line_height }};
  }

  .ai-collection-text__content-{{ ai_gen_id }} p {
    margin: 0 0 {{ block.settings.paragraph_spacing }}px 0;
  }

  .ai-collection-text__content-{{ ai_gen_id }} p:last-child {
    margin-bottom: 0;
  }

  .ai-collection-text__content-{{ ai_gen_id }} a {
    color: {{ block.settings.link_color }};
    text-decoration: underline;
  }

  .ai-collection-text__content-{{ ai_gen_id }} a:hover {
    color: {{ block.settings.link_hover_color }};
  }

  .ai-collection-text__empty-{{ ai_gen_id }} {
    color: #999;
    font-style: italic;
    padding: 40px 20px;
    text-align: center;
  }
{% endstyle %}

<collection-text-{{ ai_gen_id }}
  class="ai-collection-text-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-collection-text__container-{{ ai_gen_id }}">
    {% liquid
      assign current_collection_handle = collection.handle
      assign collection_1_handle = block.settings.collection_1 | default: ''
      assign collection_2_handle = block.settings.collection_2 | default: ''
      assign collection_3_handle = block.settings.collection_3 | default: ''
      assign collection_4_handle = block.settings.collection_4 | default: ''
      assign collection_5_handle = block.settings.collection_5 | default: ''
      
      assign matched_heading = ''
      assign matched_content = ''
      assign has_match = false
      
      if current_collection_handle == collection_1_handle and collection_1_handle != ''
        assign matched_heading = block.settings.collection_1_heading
        assign matched_content = block.settings.collection_1_content
        assign has_match = true
      elsif current_collection_handle == collection_2_handle and collection_2_handle != ''
        assign matched_heading = block.settings.collection_2_heading
        assign matched_content = block.settings.collection_2_content
        assign has_match = true
      elsif current_collection_handle == collection_3_handle and collection_3_handle != ''
        assign matched_heading = block.settings.collection_3_heading
        assign matched_content = block.settings.collection_3_content
        assign has_match = true
      elsif current_collection_handle == collection_4_handle and collection_4_handle != ''
        assign matched_heading = block.settings.collection_4_heading
        assign matched_content = block.settings.collection_4_content
        assign has_match = true
      elsif current_collection_handle == collection_5_handle and collection_5_handle != ''
        assign matched_heading = block.settings.collection_5_heading
        assign matched_content = block.settings.collection_5_content
        assign has_match = true
      endif
    %}

    {% if has_match %}
      {% if matched_heading != blank %}
        <h2 class="ai-collection-text__heading-{{ ai_gen_id }}">{{ matched_heading }}</h2>
      {% endif %}
      
      {% if matched_content != blank %}
        <div class="ai-collection-text__content-{{ ai_gen_id }}">
          {{ matched_content }}
        </div>
      {% endif %}
    {% else %}
      <div class="ai-collection-text__empty-{{ ai_gen_id }}">
        Configure collection-specific text in the block settings
      </div>
    {% endif %}
  </div>
</collection-text-{{ ai_gen_id }}>

<script>
  (function() {
    class CollectionText{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }
    }
    customElements.define('collection-text-{{ ai_gen_id }}', CollectionText{{ ai_gen_id }});
  })();
</script>

{% schema %}
