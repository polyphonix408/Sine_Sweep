    {
      "type": "text",
      "id": "collection_1_heading",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "collection_1_content",
      "label": "Content",
      "default": "<p>Add your custom text for this collection here.</p>"
    },
    {
      "type": "header",
      "content": "Collection 2"
    },
    {
      "type": "collection",
